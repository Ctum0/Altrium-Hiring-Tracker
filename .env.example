# Copy to .env and fill in values
# REQUIRED in production (DJANGO_DEBUG=False): the app refuses to boot without
# a real secret key. Generate one:
#   python -c "from django.core.management.utils import get_random_string; print(get_random_string(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True

# Comma-separated list of allowed hosts (tunnel/PaaS wildcards like
# *.trycloudflare.com are added automatically in DEBUG mode only)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Production database connection string (Render sets DATABASE_URL automatically)
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Shared cache for login rate-limiting (LocMem fallback is per-process)
# REDIS_URL=redis://localhost:6379/0

# Security (only used when DJANGO_DEBUG=False)
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=31536000

# Groq AI (optional - features degrade gracefully without it)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Object storage for CV files (Cloudflare R2 / any S3-compatible provider).
# Empty values keep files on the local filesystem. Media is served via
# short-lived signed URLs; keep the bucket private.
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=
# S3_ENDPOINT=
# S3_PUBLIC_DOMAIN=
