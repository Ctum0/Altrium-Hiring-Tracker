# Copy to .env and fill in values. Never commit .env (it's gitignored).

# ===== Core Django =====
# REQUIRED in production (DJANGO_DEBUG=False): the app refuses to boot without
# a real secret key. Generate one:
#   python -c "from django.core.management.utils import get_random_string; print(get_random_string(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True

# Comma-separated list of allowed hosts (tunnel/PaaS wildcards like
# *.trycloudflare.com are added automatically in DEBUG mode only)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Production database connection string (Render sets DATABASE_URL automatically
# via render.yaml's `fromDatabase` wiring). REQUIRED when DJANGO_DEBUG=False;
# falls back to local SQLite in dev when unset.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Shared cache for login rate-limiting (django-axes). LocMem fallback is
# per-process only — with multiple gunicorn workers, set this for real
# brute-force protection.
# REDIS_URL=redis://localhost:6379/0

# Security headers (only take effect when DJANGO_DEBUG=False)
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=31536000

# ===== AI features (optional — degrade gracefully without it) =====
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ===== Object storage for CV files (optional) =====
# Cloudflare R2 / any S3-compatible provider. Empty values keep files on the
# local filesystem instead. Media is served via short-lived signed URLs; keep
# the bucket private.
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=
# S3_ENDPOINT=
# S3_PUBLIC_DOMAIN=

# ===== Outbound email (optional) =====
# Reminder/escalation/digest cron commands log to console when unset.
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=altrium-tracker@noreply.local

# ===== One-shot boot-time commands (all idempotent, env-gated, safe to =====
# ===== leave unset — see docker-entrypoint.sh for exact behavior)     =====

# Creates demo accounts (hr_demo/iv_demo/mgmt_demo) with a hardcoded password
# (testpass123). NEVER enable unconditionally on a real production boot —
# opt in only for a disposable demo/staging deploy.
# SEED_DEMO_USERS=true

# Additionally runs clean_and_seed_db, which WIPES all jobs/candidates/
# applications/feedback and seeds a realistic enterprise demo dataset.
# WARNING: destructive to business data — opt-in only.
# SEED_DEMO_DATA=true

# First-admin bootstrap (accounts/management/commands/bootstrap_admin.py):
# a no-op once any admin account exists. Set ADMIN_USERNAME + ADMIN_PASSWORD
# (BOOTSTRAP_ADMIN=true is optional once both are set — having explicit
# credentials is treated as explicit intent).
# BOOTSTRAP_ADMIN=true
# ADMIN_USERNAME=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_FIRST_NAME=
# ADMIN_LAST_NAME=

# Credential-recovery escape hatch: force-sets ADMIN_USERNAME's password to
# ADMIN_PASSWORD even if that account already exists (bypasses the normal
# "an admin already exists" no-op guard). Toggle true for one deploy, confirm
# the new password works, then toggle back off.
# RESET_ADMIN_PASSWORD=true

# One-shot cleanup of test/audit artifacts ahead of a client demo (see
# accounts/management/commands/cleanup_demo_cruft.py for the exact, narrow
# criteria it matches). Toggle true for one deploy, confirm the log output,
# then toggle back off.
# CLEANUP_DEMO_CRUFT=true
