{
  "browser": {
    "browserName": "chromium",
    "isolated": true,
    "launchOptions": {
      "headless": true,
      "executablePath": "/home/ctum/.cache/ms-playwright/chromium-1243/chrome-linux64/chrome"
    },
    "contextOptions": {
      "viewport": { "width": 1440, "height": 900 },
